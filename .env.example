# dtask-web — copy to .env (or export) before running `bun server.ts`.
# The server reads plain process env vars; run.sh wires these for you.

# ── Server ──────────────────────────────────────────────────────────
# Listen port (also accepts legacy BTASK_PORT)
DTASK_PORT=8787

# SQLite database file (WAL mode is enabled automatically)
DTASK_DB=./db.sqlite

# ── Security knobs ──────────────────────────────────────────────────
# Allowed origins for browser clients. "*" keeps the CLI-first posture.
# Set to your site origin (e.g. https://dtask.example.com) to lock /api
# down to same-origin browsers.
DTASK_CORS_ORIGIN=*

# API rate limit per bearer key (requests per minute). Falls back to
# client IP for unauthenticated hits.
DTASK_RATE_LIMIT_PER_MIN=600

# Stricter per-IP limit for POST /api/users (self-registration)
DTASK_AUTH_LIMIT_PER_MIN=30
